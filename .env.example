# Hyperliquid Configuration
# Copy this to .env and fill in your credentials

# Network selection
HL_NETWORK=testnet

# Data source (optional: use mainnet data with testnet execution)
# HL_DATA_NETWORK=mainnet

# Your wallet address (for querying state)
HL_ADDRESS=0xYourWalletAddress

# API wallet private key (signs orders)
HL_SECRET_KEY=0xYourPrivateKey

# Optional: Vault address (trade on behalf of a vault)
# HL_VAULT_ADDRESS=0xYourVaultAddress

